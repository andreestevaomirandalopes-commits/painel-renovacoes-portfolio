DATABASE_URL="postgresql://user:password@localhost:5432/painel_renovacoes"
AUTH_SECRET="substitua-por-um-segredo-seguro"
# Mantenha true no portfólio: nenhum e-mail, WhatsApp ou lembrete automático será enviado.
DEMO_MODE="true"
RESEND_API_KEY=""
EMAIL_FROM="renovacoes@seudominio.com"
EMAIL_SENDER_NAME="Painel de Gestão"
EMAIL_SUBJECT="Renovação do certificado digital"
EMAIL_TEMPLATE="Olá {{nome}}, seu certificado {{produto}} vence em {{vencimento}}."
EMAIL_LOGO_URL=""
EMAIL_BRAND_COLOR="#0f766e"
# Alertas de novos CNPJs: mantenha a importação manual até contratar uma fonte de dados.
NEW_CNPJ_EMAIL_SUBJECT="Certificado digital para sua empresa"
NEW_CNPJ_EMAIL_TEMPLATE="Olá, {{razaoSocial}}! Vimos que sua empresa foi aberta recentemente. Nossa equipe pode ajudar com o certificado digital. Fale conosco para saber mais."
# Para futuras integrações, preencha somente após contratar a fonte escolhida.
CNPJ_ALERT_PROVIDER="MANUAL"
CNPJ_ALERT_PROVIDER_API_KEY=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_TEMPLATE="Olá {{nome}}, seu certificado {{produto}} vence em {{vencimento}}."
CRON_SECRET=""
# Backup: informe uma pasta sincronizada (OneDrive, Google Drive etc.) e, se necessário, o pg_dump.exe.
BACKUP_DESTINATION=""
PG_DUMP_PATH=""
